files:
  "/etc/cron.d/rs-systems-reviews":
    mode: "000644"
    owner: root
    group: root
    content: |
      # RS Systems — Review Request Emails
      # Sends pending review requests whose scheduled_at has arrived.
      # Safe under overlapping runs: rows are locked with
      # select_for_update(skip_locked=True) (CODE-230).

      */20 * * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py send_review_requests >> /var/log/review-requests.log 2>&1'

  "/opt/elasticbeanstalk/tasks/bundlelogs.d/reviews.conf":
    mode: "000755"
    owner: root
    group: root
    content: |
      /var/log/review-requests.log
