# RS Systems — Review Request Emails
# See the header of 11_billing_cron.config for the two bugs that kept every
# cron job in this app from ever running: /var/log is not writable by the
# `webapp` user (bash fails the redirect before exec), and EB's `.bak` files
# make cron register each entry twice.

files:
  "/opt/rs-systems/cron/rs-systems-reviews":
    mode: "000644"
    owner: root
    group: root
    content: |
      # RS Systems — Review Request Emails
      # Sends pending review requests whose scheduled_at has arrived.
      # Safe under overlapping runs: rows are locked with
      # select_for_update(skip_locked=True) (CODE-230).
      #
      # RE-ENABLED 2026-08-11 after checking the backlog on production:
      # `send_review_requests --dry-run` reported 0 requests ready to send,
      # so there is nothing retroactive to mail. From here it only sends
      # requests queued by repairs completed after this deploy.

      */20 * * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py send_review_requests >> /var/log/rs-systems/review-requests.log 2>&1'

  "/opt/elasticbeanstalk/tasks/bundlelogs.d/reviews.conf":
    mode: "000755"
    owner: root
    group: root
    content: |
      /var/log/rs-systems/review-requests.log

container_commands:
  01_install_reviews_cron:
    command: "install -m 000644 -o root -g root /opt/rs-systems/cron/rs-systems-reviews /etc/cron.d/rs-systems-reviews && rm -f /etc/cron.d/*.bak"
    leader_only: true
