files:
  "/etc/cron.d/rs-systems-billing":
    mode: "000644"
    owner: root
    group: root
    content: |
      # RS Systems — Billing Automation Cron Jobs
      # Runs on the leader instance only (guarded by leader_only in container_commands)

      # Run daily at 6 AM UTC — generate batch invoices for fleet customers
      0 6 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py process_batch_invoices >> /var/log/billing-batch.log 2>&1'

      # Run daily at 8 AM UTC — mark overdue invoices and send reminders
      0 8 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py process_overdue_invoices >> /var/log/billing-overdue.log 2>&1'

      # Run daily at 9 AM UTC — generate AR aging report (logged only, no email)
      0 9 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py generate_aging_report >> /var/log/billing-aging.log 2>&1'

      # Run daily at midnight UTC — expire loyalty points past their expiry date
      0 0 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py expire_loyalty_points --json >> /var/log/loyalty-expire.log 2>&1'

      # Run daily at 3 AM UTC — reconcile Reward.points cache vs PointTransaction ledger
      0 3 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py reconcile_loyalty_balances --json >> /var/log/loyalty-reconcile.log 2>&1'

      # Run daily at 9 AM UTC — subscription expiry alerts (7d/1d/0d/15d-past/5d-past/end)
      0 9 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py check_subscription_alerts >> /var/log/subscription-alerts.log 2>&1'

files:
  "/opt/elasticbeanstalk/tasks/bundlelogs.d/billing.conf":
    mode: "000755"
    owner: root
    group: root
    content: |
      /var/log/billing-batch.log
      /var/log/billing-overdue.log
      /var/log/billing-aging.log
      /var/log/loyalty-expire.log
      /var/log/loyalty-reconcile.log
      /var/log/subscription-alerts.log
