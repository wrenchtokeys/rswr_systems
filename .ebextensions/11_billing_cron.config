# RS Systems — Billing Automation Cron Jobs
#
# Three silent outages were fixed here on 2026-08-10. Read before editing.
#
# 1. This file had TWO top-level `files:` keys. YAML is last-wins, so the
#    first block (the cron table) was discarded at parse time and
#    /etc/cron.d/rs-systems-billing was never written. Every job below had
#    never run in production. Keep exactly ONE key per section.
#
# 2. Jobs redirect output to a log file, and /var/log is root-owned while
#    cron runs these as `webapp`. Bash applies redirections BEFORE exec'ing
#    the command, so each tick died with
#        bash: line 1: /var/log/x.log: Permission denied
#    and the management command never started. Logs now go to
#    /var/log/rs-systems/, created and chowned by the commands block below.
#    Never point a webapp-owned cron job at a bare /var/log/ path.
#
# 3. EB's `files:` directive leaves a `.bak` copy when it overwrites an
#    existing file, and cron reads every entry in /etc/cron.d — so each job
#    was registered twice and ran twice per tick. The container command
#    below purges them after installation.
#
# Entries are staged under /opt/rs-systems/cron and installed by a
# leader_only container command, so scaling past one instance cannot
# double-run process_batch_invoices (which would double-invoice customers).

files:
  # Every cron job goes through this. Without it a job inherits cron's bare
  # environment -- no DJANGO_SETTINGS_MODULE, no RDS_* -- so manage.py falls
  # back to development settings and talks to a stale SQLite file instead of
  # production Postgres. The jobs "run" and do nothing, or crash on a column
  # that only exists in the real database. Verified on 2026-08-11:
  # reconcile_subscriptions died with
  #   OperationalError: no such column: tenants_tenant.platform_fee_fixed_cents
  # because it was reading SQLite.
  "/opt/rs-systems/run-cron.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Usage: run-cron.sh <manage.py command> [args...]
      set -euo pipefail
      if [ ! -r /opt/rs-systems/cron.env ]; then
        echo "run-cron.sh: /opt/rs-systems/cron.env missing or unreadable" >&2
        exit 78
      fi
      set -a
      # shellcheck disable=SC1091
      . /opt/rs-systems/cron.env
      set +a
      # shellcheck disable=SC1090
      source /var/app/venv/*/bin/activate
      cd /var/app/current
      exec python manage.py "$@"

  "/opt/rs-systems/cron/rs-systems-billing":
    mode: "000644"
    owner: root
    group: root
    content: |
      # RS Systems — Billing Automation Cron Jobs
      # Installed on the leader instance only. Source of truth:
      # .ebextensions/11_billing_cron.config
      #
      # ####################################################################
      # BACKLOG SAFETY: jobs that send mail or mutate historical data are
      # DISABLED below and must stay that way until their backlog has been
      # inspected on production.
      #
      # None of these have ever executed (see the header above for the three
      # bugs). Their first run would therefore act on ~2 years of unswept
      # data all at once:
      #
      #   process_overdue_invoices  -> mails overdue reminders to REAL
      #                                CUSTOMERS for every historically
      #                                overdue invoice
      #   send_review_requests      -> mails review requests for every
      #                                ReviewRequest whose scheduled_at has
      #                                long passed (12_reviews_cron.config)
      #   check_subscription_alerts -> mails every tenant at once
      #   process_batch_invoices    -> generates invoices, which auto-invoice
      #                                may email to customers
      #   expire_loyalty_points     -> destroys points accrued over 2 years,
      #                                irreversibly. Not email, but worse.
      #
      # To enable one: run it on the instance with --dry-run first, confirm
      # the count is what you expect, then uncomment ONE line and deploy.
      # ####################################################################

      # DISABLED pending backlog review — see BACKLOG SAFETY above.
      # 0 6 * * * webapp /opt/rs-systems/run-cron.sh process_batch_invoices >> /var/log/rs-systems/billing-batch.log 2>&1

      # DISABLED BY POLICY — do not enable without the owner's explicit
      # say-so. This job emails overdue-invoice reminders directly to the
      # shop's customers. RS Systems does not chase a shop's customers on
      # its behalf; that is the shop's relationship to manage. Marking
      # invoices overdue is bundled into the same command, so that is
      # forgone too -- generate_aging_report (enabled, logged only) is the
      # read-only way to see what is outstanding.
      # 0 8 * * * webapp /opt/rs-systems/run-cron.sh process_overdue_invoices >> /var/log/rs-systems/billing-overdue.log 2>&1

      # SAFE: report is logged only, sends no email and writes no customer data.
      0 9 * * * webapp /opt/rs-systems/run-cron.sh generate_aging_report >> /var/log/rs-systems/billing-aging.log 2>&1

      # DISABLED pending backlog review — would expire 2 years of points at once.
      # 0 0 * * * webapp /opt/rs-systems/run-cron.sh expire_loyalty_points --json >> /var/log/rs-systems/loyalty-expire.log 2>&1

      # Hourly — repair subscription state drift from lost/swallowed
      # webhooks. The invoice side has reconcile_stripe_payments; this is
      # its subscription counterpart. Sends no email: it only maps Stripe's
      # current subscription state onto the tenant. Logs at WARNING whenever
      # it changes anything, which means webhook delivery is broken.
      17 * * * * webapp /opt/rs-systems/run-cron.sh reconcile_subscriptions >> /var/log/rs-systems/subscription-reconcile.log 2>&1

      # SAFE: repairs a cached balance against its own ledger. No email.
      0 3 * * * webapp /opt/rs-systems/run-cron.sh reconcile_loyalty_balances --json >> /var/log/rs-systems/loyalty-reconcile.log 2>&1

      # RE-ENABLED 2026-08-11 after checking on production: a --dry-run
      # across all tenants reported 0 alerts due, so nothing retroactive
      # goes out. From here it only warns about trials/grace periods as
      # they actually approach.
      0 9 * * * webapp /opt/rs-systems/run-cron.sh check_subscription_alerts >> /var/log/rs-systems/subscription-alerts.log 2>&1

  "/opt/elasticbeanstalk/tasks/bundlelogs.d/billing.conf":
    mode: "000755"
    owner: root
    group: root
    content: |
      /var/log/rs-systems/billing-batch.log
      /var/log/rs-systems/billing-overdue.log
      /var/log/rs-systems/billing-aging.log
      /var/log/rs-systems/loyalty-expire.log
      /var/log/rs-systems/loyalty-reconcile.log
      /var/log/rs-systems/subscription-alerts.log
      /var/log/rs-systems/subscription-reconcile.log

  # Cron output is small but these run up to 96x/day; without rotation a
  # small EB root volume fills up eventually.
  "/etc/logrotate.d/rs-systems":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/rs-systems/*.log {
          daily
          rotate 7
          compress
          delaycompress
          missingok
          notifempty
          copytruncate
          su root root
      }

commands:
  # Runs on every instance, before the app deploy. Idempotent.
  01_create_cron_log_dir:
    command: "mkdir -p /var/log/rs-systems && chown webapp:webapp /var/log/rs-systems && chmod 0755 /var/log/rs-systems"
  02_create_cron_dir:
    command: "mkdir -p /opt/rs-systems && chmod 0755 /opt/rs-systems"

container_commands:
  # Snapshot the EB environment where cron can read it. Written via python
  # with shlex.quote because the raw /opt/elasticbeanstalk/deployment/env is
  # not safely sourceable -- SECRET_KEY alone contains !, %, & and parens,
  # which break `. env` with "command not found" and syntax errors.
  #
  # 0600 webapp:webapp: this holds SECRET_KEY, the database password and
  # live Stripe keys.
  00_write_cron_env:
    command: "/opt/elasticbeanstalk/bin/get-config environment | python3 -c 'import json,sys,shlex; d=json.load(sys.stdin); print(\"\\n\".join(k+\"=\"+shlex.quote(str(v)) for k,v in d.items()))' > /opt/rs-systems/cron.env && chown webapp:webapp /opt/rs-systems/cron.env && chmod 0600 /opt/rs-systems/cron.env"
  # Installed after the app is staged, leader only. The `rm` clears the
  # `.bak` copies EB leaves behind, which cron would otherwise run as
  # duplicate entries.
  01_install_billing_cron:
    command: "install -m 000644 -o root -g root /opt/rs-systems/cron/rs-systems-billing /etc/cron.d/rs-systems-billing && rm -f /etc/cron.d/*.bak"
    leader_only: true
