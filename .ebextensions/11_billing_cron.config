# RS Systems — Billing Automation Cron Jobs
#
# Three silent outages were fixed here on 2026-08-10. Read before editing.
#
# 1. This file had TWO top-level `files:` keys. YAML is last-wins, so the
#    first block (the cron table) was discarded at parse time and
#    /etc/cron.d/rs-systems-billing was never written. Every job below had
#    never run in production. Keep exactly ONE key per section.
#
# 2. Jobs redirect output to a log file, and /var/log is root-owned while
#    cron runs these as `webapp`. Bash applies redirections BEFORE exec'ing
#    the command, so each tick died with
#        bash: line 1: /var/log/x.log: Permission denied
#    and the management command never started. Logs now go to
#    /var/log/rs-systems/, created and chowned by the commands block below.
#    Never point a webapp-owned cron job at a bare /var/log/ path.
#
# 3. EB's `files:` directive leaves a `.bak` copy when it overwrites an
#    existing file, and cron reads every entry in /etc/cron.d — so each job
#    was registered twice and ran twice per tick. The container command
#    below purges them after installation.
#
# Entries are staged under /opt/rs-systems/cron and installed by a
# leader_only container command, so scaling past one instance cannot
# double-run process_batch_invoices (which would double-invoice customers).

files:
  "/opt/rs-systems/cron/rs-systems-billing":
    mode: "000644"
    owner: root
    group: root
    content: |
      # RS Systems — Billing Automation Cron Jobs
      # Installed on the leader instance only. Source of truth:
      # .ebextensions/11_billing_cron.config

      # Run daily at 6 AM UTC — generate batch invoices for fleet customers
      0 6 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py process_batch_invoices >> /var/log/rs-systems/billing-batch.log 2>&1'

      # Run daily at 8 AM UTC — mark overdue invoices and send reminders
      0 8 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py process_overdue_invoices >> /var/log/rs-systems/billing-overdue.log 2>&1'

      # Run daily at 9 AM UTC — generate AR aging report (logged only, no email)
      0 9 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py generate_aging_report >> /var/log/rs-systems/billing-aging.log 2>&1'

      # Run daily at midnight UTC — expire loyalty points past their expiry date
      0 0 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py expire_loyalty_points --json >> /var/log/rs-systems/loyalty-expire.log 2>&1'

      # Run daily at 3 AM UTC — reconcile Reward.points cache vs PointTransaction ledger
      0 3 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py reconcile_loyalty_balances --json >> /var/log/rs-systems/loyalty-reconcile.log 2>&1'

      # Run daily at 9 AM UTC — subscription expiry alerts (7d/1d/0d/15d-past/5d-past/end)
      0 9 * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py check_subscription_alerts >> /var/log/rs-systems/subscription-alerts.log 2>&1'

      # Hourly — repair subscription state drift from lost/swallowed webhooks.
      # The invoice side has reconcile_stripe_payments; this is its
      # subscription counterpart. Logs at WARNING whenever it changes
      # anything, which means webhook delivery is broken.
      17 * * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py reconcile_subscriptions >> /var/log/rs-systems/subscription-reconcile.log 2>&1'

  "/opt/elasticbeanstalk/tasks/bundlelogs.d/billing.conf":
    mode: "000755"
    owner: root
    group: root
    content: |
      /var/log/rs-systems/billing-batch.log
      /var/log/rs-systems/billing-overdue.log
      /var/log/rs-systems/billing-aging.log
      /var/log/rs-systems/loyalty-expire.log
      /var/log/rs-systems/loyalty-reconcile.log
      /var/log/rs-systems/subscription-alerts.log
      /var/log/rs-systems/subscription-reconcile.log

  # Cron output is small but these run up to 96x/day; without rotation a
  # small EB root volume fills up eventually.
  "/etc/logrotate.d/rs-systems":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/rs-systems/*.log {
          daily
          rotate 7
          compress
          delaycompress
          missingok
          notifempty
          copytruncate
          su root root
      }

commands:
  # Runs on every instance, before the app deploy. Idempotent.
  01_create_cron_log_dir:
    command: "mkdir -p /var/log/rs-systems && chown webapp:webapp /var/log/rs-systems && chmod 0755 /var/log/rs-systems"

container_commands:
  # Installed after the app is staged, leader only. The `rm` clears the
  # `.bak` copies EB leaves behind, which cron would otherwise run as
  # duplicate entries.
  01_install_billing_cron:
    command: "install -m 000644 -o root -g root /opt/rs-systems/cron/rs-systems-billing /etc/cron.d/rs-systems-billing && rm -f /etc/cron.d/*.bak"
    leader_only: true
