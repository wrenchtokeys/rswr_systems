# Temporary: Run notification diagnostic on deployment
# This file can be removed after diagnosis
container_commands:
  99_diagnostic:
    command: "python manage.py check_notifications > /var/log/notification_diagnostic.log 2>&1 || true"
    leader_only: true
    ignoreErrors: true

files:
  "/opt/elasticbeanstalk/tasks/bundlelogs.d/notification_diagnostic.conf":
    mode: "000755"
    owner: root
    group: root
    content: |
      /var/log/notification_diagnostic.log
