# RS Systems — Stripe payment reconciliation (webhook safety net)
# See the header of 11_billing_cron.config for the two bugs that kept every
# cron job in this app from ever running: /var/log is not writable by the
# `webapp` user (bash fails the redirect before exec), and EB's `.bak` files
# make cron register each entry twice.

files:
  "/opt/rs-systems/cron/rs-systems-stripe-reconcile":
    mode: "000644"
    owner: root
    group: root
    content: |
      # RS Systems — Stripe payment reconciliation (webhook safety net)
      # Verifies recent open checkout sessions directly with Stripe and
      # records any paid ones the webhook missed. Idempotent: payments
      # key on the payment_intent id, so webhook retries can't double-record.
      #
      # RE-ENABLED 2026-08-11. This is the safety net for lost Stripe
      # webhooks and had never once executed, so any payment the webhook
      # missed is still unrecorded -- an invoice showing unpaid that the
      # customer has already paid.
      #
      # Backlog checked on production first: 5 OPEN attempts, three of them
      # for INV-1008 which is already PAID (those dedupe on payment_intent
      # id, so they record nothing and mail no customer; at most the shop
      # gets an "already paid, please review" alert). The other two are on
      # DRAFT invoices -- and if either turns out to have been paid, then
      # recording it and sending that customer their receipt is precisely
      # the bug this job exists to catch.
      #
      # Recording a payment calls PaymentNotificationService, which emails
      # the customer a receipt. Correct for a real payment; only dangerous
      # when run cold against a large backlog, which this is not.

      */15 * * * * webapp /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py reconcile_stripe_payments >> /var/log/rs-systems/stripe-reconcile.log 2>&1'

  "/opt/elasticbeanstalk/tasks/bundlelogs.d/stripe-reconcile.conf":
    mode: "000755"
    owner: root
    group: root
    content: |
      /var/log/rs-systems/stripe-reconcile.log

container_commands:
  01_install_stripe_reconcile_cron:
    command: "install -m 000644 -o root -g root /opt/rs-systems/cron/rs-systems-stripe-reconcile /etc/cron.d/rs-systems-stripe-reconcile && rm -f /etc/cron.d/*.bak"
    leader_only: true
