# Run Django migrations and sync email verification after deployment
container_commands:
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
  02_sync_email_verification:
    command: "python manage.py sync_email_verification"
    leader_only: true
  03_fix_connect_account:
    command: "python manage.py fix_connect_account"
    leader_only: true