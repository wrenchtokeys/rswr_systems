# HTTPS Configuration
# SSL certificate for rssystems.io
# Certificate ARN: arn:aws:acm:us-east-1:973196283632:certificate/7e37d302-1d0b-4b4e-a80d-53a2d25ba2e7
# Status: PENDING (waiting for ACM certificate for rssystems.io)
# Domains: rssystems.io, *.rssystems.io

option_settings:
  # HTTP listener - redirects to HTTPS (see 09_https_redirect.config)
  aws:elbv2:listener:80:
    Protocol: HTTP

  # HTTPS listener with SSL certificate
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:us-east-1:973196283632:certificate/7e37d302-1d0b-4b4e-a80d-53a2d25ba2e7
    DefaultProcess: default

  # Environment variables for HTTPS enforcement
  aws:elasticbeanstalk:application:environment:
    HTTPS_AVAILABLE: "true"
    FORCE_HTTPS: "true"
    SSL_CERTIFICATE_ARN: "arn:aws:acm:us-east-1:973196283632:certificate/7e37d302-1d0b-4b4e-a80d-53a2d25ba2e7"