# HTTPS Configuration
# SSL certificate using DNS validation
#
# IMPORTANT: Replace SSL_CERTIFICATE_ARN in your actual deployment
# Get your certificate ARN from AWS ACM console after validation

option_settings:
  # HTTP listener - will redirect to HTTPS when certificate is validated
  aws:elbv2:listener:80:
    Protocol: HTTP

  # HTTPS listener with SSL certificate
  # IMPORTANT: Set SSL_CERTIFICATE_ARN environment variable before deploying
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: '`{"Fn::GetOptionSetting": {"Namespace": "aws:elasticbeanstalk:application:environment", "OptionName": "SSL_CERTIFICATE_ARN", "DefaultValue": ""}}`'
    DefaultProcess: default

  # Environment variables for HTTPS enforcement
  aws:elasticbeanstalk:application:environment:
    HTTPS_AVAILABLE: "true"
    FORCE_HTTPS: "true"
    # SSL_CERTIFICATE_ARN: "arn:aws:acm:REGION:YOUR_AWS_ACCOUNT_ID:certificate/YOUR_CERTIFICATE_ID"

# Setup Instructions:
# 1. Request SSL certificate in AWS ACM for your domain(s)
# 2. Add DNS validation records provided by ACM
# 3. Wait for certificate status to show "ISSUED"
# 4. Set SSL_CERTIFICATE_ARN environment variable:
#    eb setenv SSL_CERTIFICATE_ARN=arn:aws:acm:REGION:ACCOUNT_ID:certificate/CERT_ID
# 5. Deploy with: eb deploy