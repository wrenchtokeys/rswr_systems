# HTTPS Configuration
# SSL certificate for rockstarwindshield.repair
# Certificate ARN: arn:aws:acm:us-east-1:973196283632:certificate/f45b1d1c-8fb7-4242-9dad-9258e591e60a
# Status: ISSUED
# Domains: rockstarwindshield.repair, www.rockstarwindshield.repair, app.rockstarwindshield.repair

option_settings:
  # HTTP listener - redirects to HTTPS (see 09_https_redirect.config)
  aws:elbv2:listener:80:
    Protocol: HTTP

  # HTTPS listener with SSL certificate
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:us-east-1:973196283632:certificate/f45b1d1c-8fb7-4242-9dad-9258e591e60a
    DefaultProcess: default

  # Environment variables for HTTPS enforcement
  aws:elasticbeanstalk:application:environment:
    HTTPS_AVAILABLE: "true"
    FORCE_HTTPS: "true"
    SSL_CERTIFICATE_ARN: "arn:aws:acm:us-east-1:973196283632:certificate/f45b1d1c-8fb7-4242-9dad-9258e591e60a"