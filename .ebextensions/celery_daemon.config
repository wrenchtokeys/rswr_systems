# Simple Celery daemon - starts as background process
# More reliable than systemd for EB single-instance environments

files:
  "/usr/local/bin/celery_daemon.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Celery worker daemon with auto-restart

      LOG_FILE="/var/log/celery-worker.log"
      PID_FILE="/var/run/celery-worker.pid"

      # Find virtual environment
      VENV_BIN=$(find /var/app/venv -type f -name activate 2>/dev/null | head -1 | xargs dirname)

      if [ -z "$VENV_BIN" ]; then
        echo "$(date): ERROR - Virtual environment not found" >> $LOG_FILE
        exit 1
      fi

      echo "$(date): Starting Celery worker (venv: $VENV_BIN)" >> $LOG_FILE

      # Load environment variables
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        set -a
        source /opt/elasticbeanstalk/deployment/env
        set +a
      fi

      # Change to app directory
      cd /var/app/current

      # Start Celery with auto-restart loop
      while true; do
        echo "$(date): Starting Celery worker process..." >> $LOG_FILE

        $VENV_BIN/celery -A rs_systems worker \
          --loglevel=info \
          --concurrency=2 \
          --logfile=$LOG_FILE \
          --pidfile=$PID_FILE

        EXIT_CODE=$?
        echo "$(date): Celery exited with code $EXIT_CODE, restarting in 5 seconds..." >> $LOG_FILE
        sleep 5
      done

  "/etc/cron.d/celery_monitor":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Ensure Celery daemon is running (check every 5 minutes)
      */5 * * * * root /usr/local/bin/ensure_celery_running.sh >> /var/log/celery-monitor.log 2>&1

  "/usr/local/bin/ensure_celery_running.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Check if Celery daemon is running, start if not

      if ! pgrep -f "celery.*worker" > /dev/null; then
        echo "$(date): Celery not running, starting daemon..."
        /usr/local/bin/start_celery_daemon.sh
      fi

  "/usr/local/bin/start_celery_daemon.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Start Celery daemon in background

      # Kill any existing Celery processes
      pkill -f "celery.*worker" || true
      sleep 2

      # Start daemon as webapp user, fully detached
      nohup su webapp -c "/usr/local/bin/celery_daemon.sh" >/dev/null 2>&1 &
      DAEMON_PID=$!

      echo "$(date): Celery daemon started (PID: $DAEMON_PID)" >> /var/log/celery-monitor.log

      # Give it a moment to start
      sleep 2

      # Check if it's running
      if pgrep -f "celery.*worker" > /dev/null; then
        echo "$(date): Celery worker confirmed running" >> /var/log/celery-monitor.log
      else
        echo "$(date): WARNING: Celery worker not detected after startup" >> /var/log/celery-monitor.log
      fi

commands:
  01_create_log_files:
    command: "touch /var/log/celery-worker.log /var/log/celery-monitor.log && chown webapp:webapp /var/log/celery-*.log"
    ignoreErrors: true

  02_kill_old_celery:
    command: "pkill -f 'celery.*worker' || true"
    ignoreErrors: true

container_commands:
  01_start_celery_daemon:
    command: "/usr/local/bin/start_celery_daemon.sh"
    leader_only: true
